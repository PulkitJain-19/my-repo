/* =========================================================== */
/* VizFrame Configuration (after rendering)                    */
/* =========================================================== */

onAfterRendering: function () {
    this._applyVizProperties();
},

_applyVizProperties: function () {

    const oVizFrame = this.byId("realTimeVizFrame");
    if (!oVizFrame) {
        return;
    }

    oVizFrame.setVizProperties({
        plotArea: {
            dataLabel: {
                visible: false
            },
            marker: {
                visible: true
            },
            dataShape: {
                primaryAxis: ["line"],
                secondaryAxis: ["line"]
            }
        },
        valueAxis: {
            title: {
                visible: true,
                text: "Real Time %"
            },
            min: 0,
            max: 100
        },
        valueAxis2: {
            title: {
                visible: true,
                text: "Overtime %"
            },
            min: 0,
            max: 20
        },
        categoryAxis: {
            title: {
                visible: false
            }
        },
        legend: {
            visible: true
        },
        title: {
            visible: false
        }
    });
}
