/* =========================================================== */
/* Graph Dialog (Fragment)                                     */
/* =========================================================== */

onOpenGraphDialog: function (oEvent) {
    const oView = this.getView();

    if (!this._oGraphDialog) {
        this._oGraphDialog = sap.ui.core.Fragment.load({
            id: oView.getId(),
            name: "com.app.view.fragments.GraphDialog",
            controller: this
        }).then(function (oDialog) {
            oView.addDependent(oDialog);
            return oDialog;
        });
    }

    this._oGraphDialog.then(function (oDialog) {
        this._prepareGraphData(oEvent);
        oDialog.open();
    }.bind(this));
},

onCloseGraphDialog: function () {
    this.byId("realTimeGraphDialog").close();
},

